{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@opentui/solid",
    "strict": true,
    "skipLibCheck": true,
    "types": ["bun-types"]
  },
  "include": [
    "demo/**/*.ts",
    "plugins/**/*.ts",
    "plugins/**/*.tsx",
    "tests/**/*.ts",
    "tests/**/*.tsx"
  ]
}
